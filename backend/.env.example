# Server Configuration
PORT=5000

# PostgreSQL / Supabase Database URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Firebase Admin Configuration
# Option A: Path to service account json file
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: Raw or Base64 JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server-Side Admin Email Allowlist (comma-separated, lowercase)
ADMIN_EMAILS=prernadixit14@gmail.com,tanvi060706@gmail.com

# JWT Secret (for legacy auth routes if needed)
JWT_SECRET=[YOUR-RANDOM-JWT-SECRET]
